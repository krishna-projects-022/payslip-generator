{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/(.*\\.\\w+)$",
      "dest": "frontend/web/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/web/index.html"
    }
  ]
}